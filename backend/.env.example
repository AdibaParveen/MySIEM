# ==============================================================================
# MySIEM — LIVE EMAIL DELIVERY CONFIGURATION (.env)
# ==============================================================================
# To have real security alert emails delivered to your personal mailbox (Gmail,
# Outlook, College email, etc.), configure the SMTP parameters below and rename
# this file to `.env` (or create a file named `.env` in this directory).
# ==============================================================================

# 1. OUTGOING MAIL SERVER (For Gmail: smtp.gmail.com, For Outlook: smtp-mail.outlook.com)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# 2. SENDER EMAIL CREDENTIALS
# Note for Gmail: Use your full Gmail address and a 16-character "App Password".
# (Google Account -> Security -> 2-Step Verification -> App Passwords)
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SENDER_EMAIL=your_email@gmail.com

# 3. DESTINATION RECIPIENTS (Where alerts will be sent)
# You can enter your personal email address here (comma-separated for multiples):
ALERT_RECIPIENTS=your_email@gmail.com
